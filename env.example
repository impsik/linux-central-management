# Helper values for install.sh and add-host.sh. Copy to .env for manual setup.
# install.sh generates and preserves these values during normal installation.

# Bootstrap token for SSH-based attachment; must match AGENT_SHARED_TOKEN in
# deploy/docker/.env. Agents receive their own runtime token after registration.
AGENT_TOKEN=change-me-agent-token

# Console token used by add-host.sh; must match AGENT_TERMINAL_TOKEN in
# deploy/docker/.env. Leave empty to keep Console disabled.
TERM_TOKEN=
